# ========================================================
# ANTWIN Frontend Environment Configuration
# ========================================================

# Production Backend API Base URL
# Set this in Vercel project settings (Environment Variables):
# Value: https://antwin-backend.onrender.com/api
VITE_API_BASE_URL=https://antwin-backend.onrender.com/api

# Optional: Explicit WebSocket URL (if not set, automatically derived from VITE_API_BASE_URL)
# Value: wss://antwin-backend.onrender.com
# VITE_WS_BASE_URL=wss://antwin-backend.onrender.com
