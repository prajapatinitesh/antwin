# ========================================================
# ANTWIN Project Root .gitignore
# ========================================================

# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example
*.env

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Python Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Python Testing & Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/
.nox/
.tox/

# --- SQLite runtime sidecar files ---
*.db-journal
*.db-wal
*.db-shm
*.sqlite-journal
*.sqlite-wal

# IMPORTANT:
# Do NOT ignore backend/antwin.db
# It is the project's pre-populated SQLite database.

# --- Node / Frontend ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
.pnp
.pnp.js

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Browser / Test Artifacts ---
test-results/
playwright-report/
blob-report/

# --- Scratch-generated media ---
scratch/*.png
scratch/*.jpg
scratch/*.jpeg
scratch/*.webp
scratch/*.webm
scratch/*.mp4

# --- IDE ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# --- OS ---
.DS_Store
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/



docs/
scratch/
scripts/
